# Copy to .env: cp .env.example .env

# Image tag for the built runner: cctc/redcap-cypress:${CYPRESS_TAG}
CYPRESS_TAG=15.10.0

# REDCap target (must match the running all-in-one container + its base URL)
REDCAP_CONTAINER=CCTC_REDCap_Docker
CYPRESS_BASE_URL=https://localhost:8443

# Browser the suite runs in
RUNNER_BROWSER=chromium

# --- External Module (EM) test run (optional) ----------------------------------
# Set EM_MODULE to a module directory name to run ONLY that External Module's
# automated_tests (its E.*.feature specs, excluding *REDUNDANT*) instead of the
# full REDCap suite. The module must be present in the running REDCap container
# (baked into the AIO image, or bind-mounted onto its modules/ dir); the runner
# copies its automated_tests out and runs them via the retry harness.
#   EM_MODULE=embellish_fields_v1.0.3
#EM_MODULE=
#CYPRESS_MAX_ATTEMPTS=3

# Host path to the Docker socket (Docker Desktop on macOS). Find yours with:
#   docker context inspect --format '{{.Endpoints.docker.Host}}'
DOCKER_SOCK=${HOME}/.docker/run/docker.sock

# --- Prebuilt image (optional) -------------------------------------------------
# Uncomment to RUN a prebuilt image pulled from GHCR instead of building locally
# (self-contained: no rebuild, no SSH). Then:
#   docker compose pull && docker compose run --rm cypress [--spec ...]
#CYPRESS_IMAGE=ghcr.io/cctc-team/redcap_cypress/cypress-runner-aio:15.10.0
